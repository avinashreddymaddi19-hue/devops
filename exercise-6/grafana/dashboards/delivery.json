{
  "uid": "delivery-operations",
  "title": "Delivery Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "total_deliveries",
          "refId": "A",
          "legendFormat": "Total Deliveries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Pending Deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pending_deliveries",
          "refId": "A",
          "legendFormat": "Pending Deliveries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "On-the-Way Deliveries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "on_the_way_deliveries",
          "refId": "A",
          "legendFormat": "On-the-Way Deliveries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Average Delivery Time (last minute)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(average_delivery_time_sum[1m]) / rate(average_delivery_time_count[1m])",
          "refId": "A",
          "legendFormat": "Average Delivery Time (last minute)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Pending Alert Firing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=\"HighPendingDeliveries\",alertstate=\"firing\"} or vector(0)",
          "refId": "A",
          "legendFormat": "Firing (1 = yes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Delivery Time Alert Firing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=\"HighAverageDeliveryTime\",alertstate=\"firing\"} or vector(0)",
          "refId": "A",
          "legendFormat": "Firing (1 = yes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
